# =============================================================================
#  Django backend env config
#  Copy this file to `.env` and fill in real values before running the server.
# =============================================================================

# ---- Core Django ------------------------------------------------------------
# Production should be DEBUG=False
DEBUG=True
SECRET_KEY=replace-me-with-a-long-random-string

# Comma-separated. In production add your server IP / domain, e.g.
#   ALLOWED_HOSTS=must.edu.mn,www.must.edu.mn,202.70.34.58
ALLOWED_HOSTS=127.0.0.1,localhost

# ---- Postgres database ------------------------------------------------------
DB_NAME=kosen
DB_USER=postgres
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# ---- Media / uploads --------------------------------------------------------
# MEDIA_ROOT is relative to BASE_DIR. Leave as `media` unless you mount
# uploads on a different volume in production.
MEDIA_ROOT=media

# Path inside MEDIA_ROOT where CKEditor stores inline image uploads.
CKEDITOR_5_UPLOAD_PATH=uploads/
