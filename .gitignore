# -------------------------
# Python cache / bytecode
# -------------------------
__pycache__/
*.py[cod]
*$py.class

# -------------------------
# Virtual environments
# -------------------------
venv/
.venv/
env/
.env.bak
env.bak/

# -------------------------
# Environment variables
# -------------------------
.env
# Keep .env.example tracked

# -------------------------
# Django stuff
# -------------------------
# NOTE: migrations MUST be committed. Do NOT add migrations/ here.

# Collected static files (run by collectstatic)
staticfiles/

# User-uploaded media (production media should live on persistent storage,
# but keep the folder structure with .gitkeep)
media/*
!media/.gitkeep

# SQLite DB (if you use it locally)
db.sqlite3

# -------------------------
# IDE / editor junk
# -------------------------
.vscode/
.idea/
*.swp
*.swo

# -------------------------
# OS files
# -------------------------
.DS_Store
Thumbs.db
